# Copy to .env and fill in. Never commit real keys.

# App
APP_ENV=development
APP_TZ=Asia/Kolkata

# SQLite. Local default is a file under this worktree.
# Docker Compose overrides this to /data/demo.db and mounts ./data -> /data.
SQLITE_PATH=data/demo.db

# Chat (optional — empty = word-count scoring and template copy)
CHAT_MODEL=xai/grok-3-mini
XAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Image gen (stub until you paste an API)
IMAGE_GEN_URL=
IMAGE_GEN_KEY=
IMAGE_GEN_MODE=stub

# Web -> API (browser calls this)
NEXT_PUBLIC_API_URL=http://localhost:8000

