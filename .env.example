# Copy to .env and fill in. Never commit real keys.

# App
APP_ENV=development
APP_TZ=Asia/Kolkata

# SQLite. Local default is a file under this worktree.
# Docker Compose overrides this to /data/demo.db and mounts ./data -> /data.
SQLITE_PATH=data/demo.db

# Brand memory markdown mirror (LEDGER.md, winners.md, lessons.md...).
# Docker Compose overrides this to /data/memory alongside SQLITE_PATH.
MEMORY_DIR=data/memory

# Text AI (scoring/copy/judge/research). Empty = ox-alpha gateway default.
CHAT_MODEL=xai/grok-4.6
XAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Image budget: hard USD cap for Grok Imagine calls (Grok is IMAGES ONLY).
IMAGE_BUDGET_USD=2.00

# Image gen. imagine = Grok Imagine (uses XAI_API_KEY). stub = dark card.
IMAGE_GEN_URL=
IMAGE_GEN_KEY=
IMAGE_GEN_MODE=imagine
IMAGE_GEN_MODEL=grok-imagine-image

# Web -> API (browser calls this)
NEXT_PUBLIC_API_URL=http://localhost:8000


# Brand fixture pack. Unset = Neutrogena. Client demo = unofficial Lay's.
BRAND_SLUG=lays
